@model List<UniConnect.Models.Evento>
@{
    ViewData["Title"] = "Inicio";
    ViewData["Subtitle"] = "Descubre eventos en tu universidad";
    var categorias = (string[])ViewBag.Categorias;
    var catSel = (string)ViewBag.CategoriaSeleccionada;
}

<form method="get" class="filter-bar">
    <div class="filter-pills">
        @foreach (var cat in categorias)
        {
            var active = cat == catSel ? "pill-active" : "";
            <button type="submit" name="categoria" value="@cat" class="pill @active">@cat</button>
        }
    </div>
    <div class="filter-extra">
        <input type="date" name="fecha" class="filter-input" />
        <input type="number" name="precioMax" placeholder="Precio máx (S/)" class="filter-input" min="0" />
        <button type="submit" class="btn-filter">Filtrar</button>
    </div>
</form>

<div class="event-grid">
    @if (!Model.Any())
    {
        <p class="empty-state">Todavía no hay eventos que coincidan con tu búsqueda.</p>
    }
    @foreach (var ev in Model)
    {
        <a href="@Url.Action("Detalle", "Eventos", new { id = ev.Id })" class="event-card">
            <div class="event-card-img" style="background-image:url('@ev.ImagenUrl')"></div>
            <div class="event-card-body">
                <span class="badge-categoria">@ev.Categoria</span>
                <h3 class="event-card-title">@ev.Titulo</h3>
                <p class="event-card-meta">📅 @ev.Fecha.ToString("d MMM yyyy") &nbsp;·&nbsp; 🏛️ @ev.Organizador.Nombre</p>
                <p class="event-card-price">
                    @(ev.Precio == 0 ? "Gratis" : $"S/ {ev.Precio}")
                </p>
            </div>
        </a>
    }
</div>